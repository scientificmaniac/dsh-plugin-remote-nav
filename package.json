{
  "name": "dsh-plugin-remote-nav",
  "version": "1.3.0-beta.4",
  "description": "DeepSeek Harness 内置插件：遥控器 / 方向键空间导航（焦点按屏幕位置移动，OK 激活，返回分层退出，会话长按滚动加速）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "screenshots.json",
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "spatial-navigation",
    "tv",
    "remote-control",
    "cordis"
  ],
  "author": "scientificmaniac",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check client.js",
    "pretest": "node scripts/build.mjs",
    "test": "node --test tests/spatial.test.mjs tests/client.test.mjs",
    "demo": "python -m http.server 8125 --directory ."
  }
}
